Universe   = vanilla
Executable = run_and_transfer_sfbdt.sh

+ProjectName="cms.org.cern"

# custom args
NEVENT = 500
NEVENTLUMIBLOCK = 500
NTHREAD = 1
EOSPATH = root://eoscms.cern.ch//store/cmst3/group/vhcc/sfTuples/$(PROCNAME)/24NanoAODv15/nanov15_$(Cluster)-$(Process).root

# note: remember to change seeds if the GEN configs are exactly the same!
BEGINSEED = 0

Arguments = $(JOBNUM) $(NEVENT) $(NEVENTLUMIBLOCK) $(NTHREAD) $(PROCNAME) $(BEGINSEED) $(EOSPATH) $(LHEPRODSCRIPT)

#requirements = (OpSysAndVer =?= "CentOS8")
Requirements = HAS_SINGULARITY == True
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"
request_cpus = 1
request_memory = 2000
use_x509userproxy = true

+JobFlavour = "tomorrow"

Log        = log/job.log_$(Cluster)
Output     = log/job.out_$(Cluster)-$(Process)
Error      = log/job.err_$(Cluster)-$(Process)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files   = dummy.cc

# ---------------
# specify PROCNAME and submit jobs

PROCNAME = QCD_bbbEnriched_HT300to500
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_bbbEnriched_HT500to700
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_bbbEnriched_HT700to1000
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_bbbEnriched_HT1000to1500
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_bbbEnriched_HT1500to2000
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_bbbEnriched_HT2000toInf
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT300to500
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT500to700
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT700to1000
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT1000to1500
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT1500to2000
Queue JOBNUM from seq 1 200 |

PROCNAME = QCD_cccEnriched_HT2000toInf
Queue JOBNUM from seq 1 200 |
